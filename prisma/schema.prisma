generator client {
  provider = "prisma-client-js"
}

datasource db {
  // "postgresql" faz o Prisma gerar SQL no dialeto do Postgres
  // (SERIAL, TIMESTAMP, DOUBLE PRECISION...) em vez do dialeto do SQLite.
  provider = "postgresql"

  // url: usada pela API em produção, no dia a dia. Aponta para o endereço
  // POOLED do Neon (aquele com "-pooler" no host).
  url = env("DATABASE_URL")

  // directUrl: usada APENAS pelos comandos de migration. Aponta para o
  // endereço DIRETO do Neon (sem "-pooler"). Migrations não funcionam
  // através de um connection pooler.
  directUrl = env("DIRECT_URL")
}= env("DATABASE_URL")


model BiblioLeitor {
  id              Int     @id @default(autoincrement())
  nome            String
  email           String  @unique
  senha           String
  matricula       String  @unique
  possuiPendencia Boolean

  criadoEm DateTime @default(now())

  emprestimos Emprestimo[]

  @@map("BiblioLeitor")
}

model CategoriaObra {
  id            Int    @id @default(autoincrement())
  nomeCategoria String

  obras Obra[]

  @@map("Categoria_Obras")
}

model Obra {
  id          Int @id @default(autoincrement())
  categoriaId Int

  categoria CategoriaObra @relation(fields: [categoriaId], references: [id])

  autor                 String
  titulo                String
  editora               String
  statusDisponibilidade String        @default("Disponivel")
  ObraExemplar          ObraExemplar?
  emprestimos           Emprestimo[]
  manutencoes           Manutencao[]

  @@map("Obras")
}

model BiblioFuncionario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
  cargo String

  criadoEm DateTime @default(now())

  emprestimos Emprestimo[]

  @@map("Funcionario")
}

model ObraExemplar {
  id                    Int    @id @default(autoincrement())
  id_obra               Int    @unique
  codigo_exemplar       String @unique
  estado_de_conservacao String

  obras Obra @relation(fields: [id_obra], references: [id])

  statusExemplar String @default("Disponivel")

  emprestimo Emprestimo[]

  @@map("ObraExemplar")
}

model Emprestimo {
  id            Int @id @default(autoincrement())
  leitorId      Int
  funcionarioId Int
  obraid        Int
  exemplarid    Int

  leitor      BiblioLeitor      @relation(fields: [leitorId], references: [id])
  funcionario BiblioFuncionario @relation(fields: [funcionarioId], references: [id])
  obra        Obra              @relation(fields: [obraid], references: [id])
  exemplar    ObraExemplar      @relation(fields: [exemplarid], references: [id])

  dataRetirada          DateTime  @default(now())
  dataPrevistaDevolucao DateTime
  dataDevolucaoReal     DateTime?

  valorTotal Float

  statusEmprestimo String @default("Aceito")

  @@map("Emprestimo")
}

model Manutencao {
  id     Int @id @default(autoincrement())
  obraid Int

  obra Obra @relation(fields: [obraid], references: [id])

  descricaoServico String
  dataManutencao   DateTime @default(now())
  valorCusto       Float

  @@map("Manutencoes")
}
